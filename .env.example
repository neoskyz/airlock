# Optional: no credentials are required for the fully labelled MOCK demo.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
CHANNEL3_API_KEY=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Replace with real sandbox recipient addresses before a real sandbox recording.
PAYPAL_SHOP_EMAIL=shop@chargers.example

# The live agent uses the selected provider key; without it, the agent is scripted.
# The independent judge uses Claude with ANTHROPIC_API_KEY, otherwise rules.
AGENT_PROVIDER=openai
AGENT_MODEL=gpt-4o-mini
AGENT_MODE=live
JUDGE_MODEL=claude-haiku-5-5
# true = deterministic scripted agent; model selection is environment-only.
DEMO_MODE=false
AIRLOCK_MODE=Monitor
SQLITE_PATH=data/audit.sqlite3
POLICY_PATH=policies/default.yaml

# Public demo limits (single process; daily LLM budget resets at midnight UTC).
RUN_RATE_LIMIT_PER_MINUTE=5
RUN_RATE_LIMIT_PER_HOUR=30
DAILY_LLM_CALL_LIMIT=500

# Local sandbox spending ledger when balance-reporting scopes are unavailable.
SANDBOX_STARTING_BALANCE=10000.00
